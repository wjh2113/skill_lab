# Cursor API Key — 完整 agent 运行时（支持真实 tool call）
# Get from: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# DeepSeek Agent — 多轮 tool call（read/write/terminal），建议使用 deepseek-chat
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Agent 最大迭代轮数（默认 25，上限 50）
# DEEPSEEK_AGENT_MAX_ITERATIONS=25

# 也可使用通用命名（与 AICV 等项目一致）
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 默认 Provider: cursor | deepseek | auto（有 Cursor Key 用 cursor，否则 DeepSeek）
# RUN_PROVIDER=auto

# Workspace root for local agent cwd (defaults to project root)
# SKILL_LAB_WORKSPACE=/Users/wayne/cursorvibecoding/skill

# Personal skills directory (defaults to ~/.cursor/skills)
# SKILL_LAB_PERSONAL_DIR=~/.cursor/skills
